<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. No ActionBar: the web app draws its own header.
         (A DarkActionBar parent here put a dark "OuiMoove" title bar above the page.) -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Shows behind the status bar (MainActivity pads the WebView below it). -->
        <item name="android:windowBackground">@android:color/white</item>
        <!-- Dark status-bar icons on the light background. -->
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="android:background">@null</item>
    </style>

    <!-- Splash. Once it finishes, Android switches to postSplashScreenTheme;
         without it the activity fell back to the old ActionBar theme. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
